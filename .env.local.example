# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see .gitignore: *.local) — never commit it.
#
# Also add the same three variables in Vercel: Project Settings ->
# Environment Variables, for Production + Preview + Development.
#
# IMPORTANT: no VITE_ prefix on any of these. A VITE_ prefix would
# embed the value into the client-side JS bundle, which defeats the
# purpose of routing all Supabase access through /api. These are only
# ever read inside api/*.ts (Node runtime), never inside src/.

SUPABASE_URL=https://yhdndlbbbgfnojwyoobr.supabase.co
SUPABASE_ANON_KEY=
FORMSPREE_ENDPOINT=https://formspree.io/f/meaqjgaq

# These two ARE meant to reach the browser bundle (hence VITE_) — used
# only by /admin/*, never by public pages. Safe to expose: the anon key
# alone grants nothing, every write is gated by RLS + admin_users
# membership. Same URL/key values as above, just VITE_-prefixed copies.
VITE_SUPABASE_URL=https://yhdndlbbbgfnojwyoobr.supabase.co
VITE_SUPABASE_ANON_KEY=
