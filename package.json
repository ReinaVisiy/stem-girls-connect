  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:programs && npm run test:girlhood",
    "test:programs": "vitest run",
    "test:girlhood": "tsx --test tests/girlhood/*.test.ts",
